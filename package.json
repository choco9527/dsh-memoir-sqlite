{
  "name": "dsh-memoir-sqlite",
  "description": "SQLite-backed local-first cross-session project memory for DeepSeek Harness, with automatic lesson distillation, CJK BM25 recall, provenance, lifecycle, and bilingual Web UI.",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "clean": "tsc --build tsconfig.build.json --clean",
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test \"test/*.test.ts\"",
    "bench": "pnpm run build && node bench/bench.mjs"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "ai-agent",
    "agent-memory",
    "bm25",
    "cache-aware",
    "cross-session",
    "deepseek",
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "hot-memory",
    "local-first",
    "memory",
    "project-memory",
    "sqlite",
    "lessons",
    "session",
    "agent",
    "typescript",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choco9527/dsh-memoir-sqlite.git"
  },
  "homepage": "https://github.com/choco9527/dsh-memoir-sqlite#readme",
  "bugs": {
    "url": "https://github.com/choco9527/dsh-memoir-sqlite/issues"
  }
}
